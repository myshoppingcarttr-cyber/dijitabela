<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/lenis@1.1.13/dist/lenis.min.js"></script>
<script src="../ortak.js"></script>
<script>
(function(){
var GS=window.gsap&&window.ScrollTrigger&&!RIT.azHareket,MOBIL=matchMedia("(max-width:980px)").matches,K=RIT.konular;
if(GS)gsap.registerPlugin(ScrollTrigger);
function $(s){return document.querySelector(s)}
$("#tarih").textContent=new Date().toLocaleDateString("tr-TR",{weekday:"long",day:"numeric",month:"long",year:"numeric",timeZone:"Europe/Istanbul"}).toUpperCase();
setInterval(function(){$("#saat").textContent=new Date().toLocaleTimeString("tr-TR",{timeZone:"Europe/Istanbul",hour:"2-digit",minute:"2-digit"})},1000);
addEventListener("scroll",function(){var d=document.documentElement;$("#okuma").style.width=(d.scrollTop/(d.scrollHeight-d.clientHeight)*100)+"%"},{passive:true});
if(GS&&window.Lenis){var lenis=new Lenis({lerp:.1});lenis.on("scroll",ScrollTrigger.update);gsap.ticker.add(function(t){lenis.raf(t*1000)});gsap.ticker.lagSmoothing(0);
  document.querySelectorAll('a[href^="#"]').forEach(function(a){a.addEventListener("click",function(e){var h=a.getAttribute("href");if(h.length>1&&$(h)){e.preventDefault();lenis.scrollTo(h,{offset:-80})}})})}
RIT.tv($("#bant"),"ticker-tape",{symbols:RIT.sembolBant,colorTheme:"light",displayMode:"regular",showSymbolLogo:false});

/* hero: pencere açılır gibi büyüyen görsel */
if(GS&&!MOBIL){gsap.from("#h1 .kel>span",{yPercent:110,duration:1.1,stagger:.1,ease:"power4.out",delay:.2});
  var tl=gsap.timeline({scrollTrigger:{trigger:"#hero",start:"top top",end:"bottom bottom",scrub:.6}});
  tl.to("#hero-gorsel",{clipPath:"inset(0% 0% 0% 0%)",ease:"none"},0).to("#hero-gorsel img",{scale:1,ease:"none"},0).to("#hero-alt",{opacity:1,ease:"none"},.5)}

/* metro haritası */
var HAT=[[60,110,840,110],[60,250,840,250],[60,390,840,390],[60,530,840,530]];
var svg=$("#metro"),ns="http://www.w3.org/2000/svg",DUR={};
function el(t,a){var e=document.createElementNS(ns,t);for(var k in a)e.setAttribute(k,a[k]);return e}
$("#lejant").innerHTML=K.map(function(k){return "<span><i style='background:"+k.renk+"'></i>"+k.k+" · "+k.ad.split(" ").slice(0,2).join(" ")+"</span>"}).join("");
// aktarma bağlantıları (programlar arası geçiş)
[[0,8,1,0],[1,8,2,0],[2,8,3,0]].forEach(function(b){var x1=60+b[1]*97.5,y1=110+b[0]*140,x2=60+b[3]*97.5,y2=110+b[2]*140;svg.appendChild(el("path",{d:"M"+x1+" "+y1+" C"+(x1+60)+" "+(y1+70)+" "+(x2-60)+" "+(y2-70)+" "+x2+" "+y2,fill:"none",stroke:"#cfd2cb","stroke-width":6,"stroke-dasharray":"2 10","stroke-linecap":"round"}))});
K.forEach(function(k,i){var y=110+i*140;svg.appendChild(el("line",{x1:60,y1:y,x2:840,y2:y,stroke:k.renk,"stroke-width":10,"stroke-linecap":"round",opacity:.22,"class":"hat-zemin"}));
  var hat=el("line",{x1:60,y1:y,x2:840,y2:y,stroke:k.renk,"stroke-width":10,"stroke-linecap":"round","class":"hat","data-k":k.k});hat.style.strokeDasharray=780;hat.style.strokeDashoffset=780;svg.appendChild(hat);
  var etk=el("text",{x:20,y:y+6,"font-family":"Archivo","font-weight":900,"font-size":30,fill:k.renk});etk.textContent=k.k;svg.appendChild(etk);
  k.dersler.forEach(function(d,n){var x=60+n*97.5,g=el("g",{"class":"durak",tabindex:0,style:"cursor:pointer"});
    var c=el("circle",{cx:x,cy:y,r:11,fill:"#fff",stroke:k.renk,"stroke-width":5});g.appendChild(c);
    var t=el("text",{x:x,y:y+(n%2?34:-22),"text-anchor":"middle","font-family":"Space Mono","font-size":11,"font-weight":700,fill:"#535960"});t.textContent=k.k+(n+1);g.appendChild(t);
    g.addEventListener("mouseenter",function(){bilgi(k,n)});g.addEventListener("click",function(){bilgi(k,n)});g.addEventListener("focus",function(){bilgi(k,n)});
    svg.appendChild(g);DUR[k.k+n]=c})});
function bilgi(k,n){var b=$("#durak-bilgi");b.innerHTML="<b>PROGRAM "+k.k+" · DURAK "+(n+1)+"</b>"+k.dersler[n];b.classList.add("on");clearTimeout(bilgi.z);bilgi.z=setTimeout(function(){b.classList.remove("on")},3500)}
function hatCiz(sira){svg.querySelectorAll(".hat").forEach(function(h){h.style.transition="none";h.style.strokeDashoffset=780});
  Object.keys(DUR).forEach(function(k){DUR[k].setAttribute("r",11)});
  sira.forEach(function(i,j){var h=svg.querySelector('.hat[data-k="'+K[i].k+'"]');setTimeout(function(){h.style.transition="stroke-dashoffset 1.4s cubic-bezier(.6,0,.2,1)";h.style.strokeDashoffset=0;
    K[i].dersler.forEach(function(_,n){setTimeout(function(){DUR[K[i].k+n].setAttribute("r",15)},n*140)})},j*900)})}
if(GS)ScrollTrigger.create({trigger:".harita",start:"top 75%",once:true,onEnter:function(){hatCiz([0,1,2,3])}});else hatCiz([0,1,2,3]);

/* seviye testi */
var T=[["Hisse senedi ile tahvil arasındaki farkı biliyor musunuz?",[["İlk kez duyuyorum",0],["Kabaca",1],["Rahatça açıklarım",2]]],["Daha önce yatırım yaptınız mı?",[["Hiç",0],["Mevduat, altın, döviz",1],["Borsa, fon veya türev",2]]],["Grafikte destek-direnç çizebilir misiniz?",[["Hayır",0],["Biraz",1],["Düzenli kullanırım",2]]],["Faiz kararlarını takip ediyor musunuz?",[["Hayır",0],["Haberlerde görürsem",1],["Ekonomik takvimden",2]]],["İşlem öncesi zarar kesi belirler misiniz?",[["Kavramı bilmiyorum",0],["Bazen",1],["Her zaman",2]]]];
var ti=0,tp=0,te=$("#test");
function tCiz(){if(ti>=T.length)return tSon();var q=T[ti];te.innerHTML="<div class='cizgi'>"+T.map(function(_,n){return "<i class='"+(n<ti?"d":"")+"'></i>"}).join("")+"</div><span class='mono adim'>Soru "+(ti+1)+" / "+T.length+"</span><h4>"+q[0]+"</h4>"+q[1].map(function(c){return "<button class='secenek' data-p='"+c[1]+"'>"+c[0]+"</button>"}).join("");
  te.querySelectorAll(".secenek").forEach(function(b){b.onclick=function(){tp+=+b.dataset.p;ti++;tCiz()}})}
function tSon(){var sv=tp<=3?0:tp<=7?1:2,ad=["Başlangıç","Orta","İleri"][sv],sira=[[0,2,1,3],[2,1,3],[3,1]][sv];
  te.innerHTML="<div class='sonuc'><span class='mono adim'>Sonuç · "+tp+" / 10 puan</span><h4>Seviyeniz: "+ad+"</h4><p style='color:var(--sa)'>Rotanız haritada çiziliyor:</p><ol>"+sira.map(function(i){return "<li><b style='color:"+K[i].renk+"'>"+K[i].k+"</b> · "+K[i].ad+"</li>"}).join("")+(sv===2?"<li><b>SPL</b> · deneme sınavı</li>":"")+"</ol><a href='#uyelik' class='btn ana'>Bu rotayla üye ol →</a> <button class='btn' id='t-yeni' style='margin-top:8px'>Tekrar</button></div>";
  $("#t-yeni").onclick=function(){ti=0;tp=0;tCiz();hatCiz([0,1,2,3])};hatCiz(sira)}
tCiz();

/* programlar: yapışkan harf + kayan dersler */
var SV=["Başlangıç","Orta","Orta","İleri"],pb=$("#p-bloklar");
K.forEach(function(k,i){var d=document.createElement("div");d.className="prog-blok";d.style.setProperty("--rk",k.renk);d.dataset.i=i;
  d.innerHTML="<span class='mono'>Program "+k.k+" · 9 ders · "+SV[i]+"</span><h4>"+k.ad+"</h4><ol>"+k.dersler.map(function(x,n){return "<li>"+x+"<span>"+(12+n*2)+" DK</span></li>"}).join("")+"</ol>";pb.appendChild(d)});
function progSec(i){var k=K[i];$("#p-harf").textContent=k.k;$("#p-harf").style.color=k.renk;$("#p-ad").textContent=k.ad;$("#p-ozet").textContent=k.ozet}
progSec(0);if(GS)document.querySelectorAll(".prog-blok").forEach(function(b){ScrollTrigger.create({trigger:b,start:"top 55%",end:"bottom 55%",onToggle:function(s){if(s.isActive)progSec(+b.dataset.i)}})});

/* analiz: zaman çizelgesi kaydırmayla */
var zl=document.querySelectorAll("#zc li");
if(GS)ScrollTrigger.create({trigger:"#yazi",start:"top 60%",end:"bottom 60%",onUpdate:function(s){var a=Math.min(4,Math.floor(s.progress*5));zl.forEach(function(l,j){l.classList.toggle("on",j<=a)})}});else zl.forEach(function(l){l.classList.add("on")});

/* SPL */
function rekor(){try{$("#rekor").textContent="%"+(localStorage.getItem("rit-en-iyi-t2")||0)}catch(e){}}rekor();
RIT.sinav($("#sinav"),{adet:6,ad:"t2",bitince:function(){rekor()}});

/* sertifika: canlı + 3B eğim + PNG */
var sp=$("#s-pr");sp.innerHTML=K.map(function(k){return "<option>"+k.ad+"</option>"}).join("");
$("#s-tarih").textContent=new Date().toLocaleDateString("tr-TR");$("#s-no").textContent=new Date().getFullYear()+"-"+Math.floor(1000+Math.random()*8999);
function sGun(){$("#s-isim").textContent=$("#s-ad").value||"Adınız Soyadınız";$("#s-prog").textContent=sp.value}
$("#s-ad").oninput=sGun;sp.onchange=sGun;
var sert=$("#sert");if(!RIT.azHareket&&!MOBIL){sert.parentNode.addEventListener("mousemove",function(e){var r=sert.getBoundingClientRect(),x=(e.clientX-r.left)/r.width-.5,y=(e.clientY-r.top)/r.height-.5;sert.style.transform="rotateY("+x*14+"deg) rotateX("+(-y*14)+"deg)"});sert.parentNode.addEventListener("mouseleave",function(){sert.style.transform=""})}
$("#s-indir").onclick=function(){var W=1414,H=1000,c=document.createElement("canvas");c.width=W;c.height=H;var x=c.getContext("2d");
  x.fillStyle="#fffdf6";x.fillRect(0,0,W,H);x.strokeStyle="#a8842c";x.lineWidth=4;x.strokeRect(28,28,W-56,H-56);x.lineWidth=1.5;x.strokeRect(42,42,W-84,H-84);x.textAlign="center";
  x.font="900 54px Archivo";x.fillStyle="#c62828";var w1=x.measureText("Run").width;x.fillStyle="#1f5fd6";var w2=x.measureText("InvestingTR").width;var s=W/2-(w1+w2)/2;x.textAlign="left";x.fillStyle="#c62828";x.fillText("Run",s,210);x.fillStyle="#1f5fd6";x.fillText("InvestingTR",s+w1,210);x.textAlign="center";
  x.font="700 18px 'Space Mono'";x.fillStyle="#535960";x.fillText("A K A D E M İ",W/2,248);x.fillStyle="#a8842c";x.font="700 26px 'Space Mono'";x.fillText("BAŞARI SERTİFİKASI",W/2,340);
  x.fillStyle="#15171a";x.font="italic 600 76px Fraunces";x.fillText($("#s-ad").value||"Adınız Soyadınız",W/2,470);x.strokeStyle="#cfd2cb";x.beginPath();x.moveTo(W/2-360,500);x.lineTo(W/2+360,500);x.stroke();
  x.fillStyle="#535960";x.font="500 24px 'Plus Jakarta Sans'";x.fillText("Bu sertifika, RunInvestingTR Akademi bünyesinde yer alan "+sp.value,W/2,580);x.fillText("eğitim programının tüm derslerini başarıyla tamamladığı için düzenlenmiştir.",W/2,618);
  x.font="700 20px 'Space Mono'";x.textAlign="left";x.fillText("TARİH "+$("#s-tarih").textContent,150,860);x.textAlign="right";x.fillText("NO RIT-"+$("#s-no").textContent,W-150,860);
  var g=x.createRadialGradient(W-260,760,10,W-260,760,90);g.addColorStop(0,"#c9a447");g.addColorStop(1,"#8a6a1f");x.fillStyle=g;x.beginPath();x.arc(W-260,760,90,0,7);x.fill();x.fillStyle="#fff";x.textAlign="center";x.font="700 22px 'Space Mono'";x.fillText("RIT",W-260,755);x.fillText("ONAYLI",W-260,785);
  var a=document.createElement("a");a.download="runinvestingtr-sertifika.png";a.href=c.toDataURL("image/png");a.click();RIT.bildir("Örnek sertifika indirildi")};

/* kütüphane */
var D=[["Analiz","Tera ve Pusula Fon Krizi","PDF · 14 sayfa"],["Teknik Analiz","Mum Formasyonları Cep Rehberi","PDF · 8 sayfa"],["Okuryazarlık","Enflasyon, Faiz ve Reel Getiri","PDF · 11 sayfa"],["Psikoloji","İşlem Günlüğü Şablonu","PDF · 3 sayfa"],["Teknik Analiz","Fibonacci Uygulama Notları","Video + PDF"],["SPL","SPL 1. Düzey Mevzuat Özeti","PDF · 22 sayfa"],["Okuryazarlık","Ekonomik Takvim Okuma Kılavuzu","PDF · 6 sayfa"],["Psikoloji","Risk Yönetimi Kontrol Listesi","PDF · 2 sayfa"]];
var kat=["Tümü"].concat(D.map(function(d){return d[0]}).filter(function(v,i,a){return a.indexOf(v)===i}));
function dCiz(f){document.querySelectorAll("#filtre button").forEach(function(b){b.classList.toggle("on",b.textContent===f)});
  $("#doklar").innerHTML=D.filter(function(d){return f==="Tümü"||d[0]===f}).map(function(d){return "<a href='#uyelik' class='dok'><span class='mono t'>"+d[0]+"</span><h4>"+d[1]+"</h4><span>"+d[2]+" · ÜYELERE</span></a>"}).join("");
  if(GS)gsap.from("#doklar .dok",{y:30,opacity:0,stagger:.05,duration:.5})}
$("#filtre").innerHTML=kat.map(function(k){return "<button>"+k+"</button>"}).join("");document.querySelectorAll("#filtre button").forEach(function(b){b.onclick=function(){dCiz(b.textContent)}});dCiz("Tümü");

/* piyasa (görününce yükle) */
var tvOk=false;new IntersectionObserver(function(e,o){if(e[0].isIntersecting&&!tvOk){tvOk=true;
  RIT.tv($("#tv-genel"),"market-overview",{colorTheme:"light",dateRange:"1M",showChart:true,width:"100%",height:500,plotLineColorGrowing:"#1f5fd6",plotLineColorFalling:"#c62828",belowLineFillColorGrowing:"rgba(31,95,214,.08)",belowLineFillColorFalling:"rgba(198,40,40,.08)",
    tabs:[{title:"Emtia",symbols:[{s:"OANDA:XAUUSD",d:"Altın"},{s:"OANDA:XAGUSD",d:"Gümüş"},{s:"TVC:UKOIL",d:"Brent"}]},{title:"Endeks",symbols:[{s:"BIST:XU100",d:"BIST 100"},{s:"XETR:DAX",d:"DAX"},{s:"NASDAQ:NDX",d:"Nasdaq 100"}]},{title:"Döviz",symbols:[{s:"FX_IDC:USDTRY",d:"USD/TRY"},{s:"FX_IDC:EURTRY",d:"EUR/TRY"},{s:"FX:EURUSD",d:"EUR/USD"}]}]});
  RIT.tv($("#tv-takvim"),"events",{colorTheme:"light",width:"100%",height:500,importanceFilter:"0,1",countryFilter:"tr,us,eu,de"});o.disconnect()}},{rootMargin:"400px"}).observe($("#tv-genel"));

fetch("https://open.er-api.com/v6/latest/USD").then(function(r){return r.json()}).then(function(j){return j.rates.TRY}).catch(function(){return 49.26}).then(function(k){document.querySelectorAll("[data-usd]").forEach(function(x){x.textContent="≈ "+Math.round(x.dataset.usd*k).toLocaleString("tr-TR")+" ₺ · güncel kur "+k.toFixed(2)})});

/* bölüm hareketleri: her bölüm farklı */
if(GS){document.querySelectorAll(".bolum h2").forEach(function(h){var s=h.querySelectorAll(".kel>span");if(s.length)gsap.fromTo(s,{yPercent:105},{yPercent:0,stagger:.06,ease:"power3.out",scrollTrigger:{trigger:h,start:"top 90%",end:"top 55%",scrub:.5}})});
  gsap.utils.toArray(".yontem div").forEach(function(d,i){gsap.from(d,{y:[60,120,180][i],scrollTrigger:{trigger:".yontem",start:"top 95%",end:"top 50%",scrub:.6}})});
  gsap.from(".harita",{clipPath:"inset(0 0 100% 0)",scrollTrigger:{trigger:".harita",start:"top 90%",end:"top 45%",scrub:.6}});
  gsap.from(".sertifika",{rotateX:55,y:120,opacity:.2,scrollTrigger:{trigger:".sahne",start:"top 95%",end:"top 45%",scrub:.6}});
  gsap.fromTo("#kut-ust img",{yPercent:-8},{yPercent:8,ease:"none",scrollTrigger:{trigger:"#kut-ust",start:"top bottom",end:"bottom top",scrub:true}});
  gsap.from(".spl",{x:-80,opacity:.3,scrollTrigger:{trigger:".spl",start:"top 95%",end:"top 50%",scrub:.6}});
  gsap.utils.toArray(".fiyat").forEach(function(f,i){gsap.from(f,{y:[60,0,120][i],scrollTrigger:{trigger:".fiyat-alan",start:"top 95%",end:"top 50%",scrub:.6}})});
  gsap.fromTo("#dev",{xPercent:10},{xPercent:-10,ease:"none",scrollTrigger:{trigger:"footer",start:"top bottom",end:"bottom bottom",scrub:true}})}
})();
</script>
<script>if(window.top===window){window.DJ_REHBER={ses:"../ses/",satirlar:{"giris":{"metin":"Kurumsal Akademi tasarımındasınız. Kaydırdıkça açılan büyük görsel, kurumsal ve güven veren bir giriş yapıyor.","dosya":"t2-giris"},"rota":{"metin":"Metro haritası. Dört program dört hat, otuz altı ders otuz altı durak. Kısa seviye testini çözün, size özel rotanız haritada çizilsin.","dosya":"t2-rota"},"programlar":{"metin":"Programlar büyük harflerle tek tek sabitleniyor; her programın dersleri yanında akıyor.","dosya":"t2-programlar"},"analiz":{"metin":"Uzun analiz yazısı zaman çizelgesiyle okunuyor. Akademinin uzmanlığını gösteren bölüm bu.","dosya":"t2-analiz"},"spl":{"metin":"SPL deneme sınavı burada da çalışıyor; en iyi puanınız saklanıyor.","dosya":"t2-spl"},"sertifika":{"metin":"Adınızı yazın, sertifikanız oluşsun. Üç boyutlu döndürebilir, resim olarak indirebilirsiniz.","dosya":"t2-sertifika"},"kutuphane":{"metin":"Kütüphane: dersler, videolar ve dokümanlar konuya göre filtreleniyor.","dosya":"t2-kutuphane"},"uyelik":{"metin":"Üyelik paketleri ve sık sorulan sorular burada. İsterseniz diğer tasarımlara da bakın.","dosya":"t2-uyelik"}}};var _r=document.createElement("script");_r.src="/ornek/_dijitabela/rehber.js";_r.defer=true;document.addEventListener("DOMContentLoaded",function(){document.body.appendChild(_r)});}</script></body></html>
